# Rust 构建产物
/target
.cargo-home/
*.settings

# 变异测试输出（cargo-mutants 生成，结果不入库）
mutants.out
mutants.out.*/

# 覆盖率等测试结果产物（结果应写入文档/CI，产物不入库）
*.profraw
*.profdata
lcov.info
tarpaulin-report.html
cobertura.xml

# Fuzz（构建产物与语料库；fuzz_targets/ 与 Cargo.toml 保留）
fuzz/target/
fuzz/corpus/
fuzz/artifacts/

# Flutter 构建产物（flutter_dashboard/.gitignore 也会覆盖一部分）
flutter_dashboard/build/
flutter_dashboard/.dart_tool/
flutter_dashboard/.idea/
flutter_dashboard/*.iml

# 本地配置/敏感文件（若存在）
/var/
*.log

# 内部评审文件与答辩材料（不入库）
/fufter
/data/
